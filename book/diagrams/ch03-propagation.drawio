<mxfile host="gen"><diagram name="ch03-propagation" id="ch03-propagation"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="importDeck() 트랜잭션 안에서 recordAttempt()를 호출할 때" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="700" height="24" as="geometry"/></mxCell><mxCell id="c4" value="recordAttempt가 REQUIRED" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=13;align=left;verticalAlign=top;fontColor=#82b366;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="24" as="geometry"/></mxCell><mxCell id="c5" value="importDeck 트랜잭션 (커넥션 A)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="700" height="40" as="geometry"/></mxCell><mxCell id="c6" value="recordAttempt: 바깥 트랜잭션에 참여" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="360" y="135" width="240" height="36" as="geometry"/></mxCell><mxCell id="c7" value="트랜잭션" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="100" height="30" as="geometry"/></mxCell><mxCell id="c8" value="내부 호출" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="138" width="100" height="30" as="geometry"/></mxCell><mxCell id="c9" value="커넥션 하나. 바깥이 커밋되면 함께 커밋, 롤백되면 함께 롤백된다.&lt;br&gt;참여하는 쪽에 격리 수준을 지정해도 반영되지 않는다." style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="178" width="700" height="40" as="geometry"/></mxCell><mxCell id="c10" value="recordAttempt가 REQUIRES_NEW" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=13;align=left;verticalAlign=top;fontColor=#d79b00;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="240" height="24" as="geometry"/></mxCell><mxCell id="c11" value="importDeck 트랜잭션 (커넥션 A)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="240" height="40" as="geometry"/></mxCell><mxCell id="c12" value="미뤄 둠 (suspend)&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;커넥션 A는 반납하지 않고 보관&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="240" height="40" as="geometry"/></mxCell><mxCell id="c13" value="재개 → 커밋/롤백" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="600" y="270" width="220" height="40" as="geometry"/></mxCell><mxCell id="c14" value="recordAttempt: 새 트랜잭션 (커넥션 B)&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;독립적으로 커밋&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="315" width="240" height="40" as="geometry"/></mxCell><mxCell id="c15" value="트랜잭션" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="275" width="100" height="30" as="geometry"/></mxCell><mxCell id="c16" value="내부 호출" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="100" height="30" as="geometry"/></mxCell><mxCell id="c17" value="커넥션 둘을 동시에 잡는다. 바깥이 롤백되어도 시도 이력은 남는다.&lt;br&gt;풀이 작은 환경에서 이런 호출이 겹치면 커넥션 풀이 바닥나 서로를 기다릴 수 있다." style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="362" width="700" height="44" as="geometry"/></mxCell><mxCell id="c18" value="시간 →" style="html=1;edgeStyle=none;strokeColor=#999999;strokeWidth=1;fontFamily=Noto Sans CJK KR;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="430" as="sourcePoint"/><mxPoint x="820" y="430" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>