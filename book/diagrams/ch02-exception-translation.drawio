ackgroundColor=#ffffff;endFill=0;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="번역" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;호출하는 코드&lt;/b&gt;: 의미 있는 타입만 골라 잡는다&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;catch (DuplicateKeyException e) { … 이미 있으면 기존 덱 사용 … } &amp;nbsp; 나머지는 그대로 전파&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="340" width="600" height="60" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=12;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="DB마다 다른 에러 코드는 여기서 끝난다.&lt;br&gt;DB를 바꿔도 오른쪽 예외 타입은 그대로다." style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="350" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>