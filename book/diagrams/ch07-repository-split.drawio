ontFamily=Noto Sans CJK KR;fontSize=12;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1;fontFamily=Noto Sans CJK KR;fontSize=12;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="표준 CRUD는 상속으로, 조건 검색은 커스텀 인터페이스로 선언한다.&lt;br&gt;구현 클래스는 빈으로 직접 등록하지 않아도 되고,&lt;br&gt;생성자는 EntityJdbcProvider를 받아 상위 클래스에 넘긴다." style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="360" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>