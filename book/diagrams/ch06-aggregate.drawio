ry"/></mxCell><mxCell id="c12" value="cards N행 다시 쓰기&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;리스트에서 빠진 카드는 delete&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=11;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="232" width="180" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1;fontFamily=Noto Sans CJK KR;fontSize=12;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="다른 애그리거트 (예: 회원)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="220" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Member&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;MemberRepository로 따로 조회&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="180" height="60" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=12;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="116"/><mxPoint x="420" y="310"/><mxPoint x="890" y="310"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Long memberId: 객체 참조가 아니라 id 참조" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="312" width="320" height="24" as="geometry"/></mxCell><mxCell id="c18" value="애그리거트는 트랜잭션과 잠금의 범위다. 통째로 다시 쓰는 비용이 커지지 않도록 작게 유지하고,&lt;br&gt;애그리거트끼리는 id로만 참조한다. 지연 로딩이 없는 것은 이 크기를 지키라는 제약이다." style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK KR;fontSize=12;align=center;verticalAlign=top;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="345" width="980" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>